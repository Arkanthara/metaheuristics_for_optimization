@startuml

start

:Choose initial configuration randomly;
:Compute initial temperature;

while (State of equilibrium reached?) is (no)

  :Choose configuration randomly;

  :Compute probability to accept the configuration
  according to the **Metropolis rule**;
  if (Is accepted?) then (yes)
    :Update configuration;
  endif

  if (Best solution to update ?) then (yes)
    :Update best solution;
  endif

  if (Temperature to update?) then (yes)
    :Update temperature;
  endif

endwhile (yes)

:Return best solution;
stop

@enduml


